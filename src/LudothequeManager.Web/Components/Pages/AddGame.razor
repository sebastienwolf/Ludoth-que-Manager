@page "/jeux/ajouter"
@rendermode InteractiveServer
@using LudothequeManager.Models
@using LudothequeManager.Data
@inject NavigationManager Navigation

<PageTitle>Ajouter un jeu</PageTitle>

<h1>Ajouter un jeu</h1>

<label for="game-name">Nom du jeu</label>
<input id="game-name" class="form-control" @bind="name" />

<label for="game-publisher">Éditeur</label>
<input id="game-publisher" class="form-control" @bind="publisher" />

<button class="btn btn-primary mt-3" @onclick="SaveGame">
    Enregistrer
</button>

<p>@message</p>

<a href="/catalogue">Retour au catalogue</a>

@code {
    private string name = "";
    private string publisher = "";
    private string message = "";

    private void SaveGame()
    {
        if (string.IsNullOrWhiteSpace(name)
            || string.IsNullOrWhiteSpace(publisher))
        {
            message = "Remplis le nom et l’éditeur.";
            return;
        }

        var game = new Game
        {
            Name = name.Trim(),
            Publisher = publisher.Trim()
        };

        using var db = new LudothequeDbContext();
        db.Games.Add(game);
        db.SaveChanges();
        Navigation.NavigateTo("/catalogue");
    }
}