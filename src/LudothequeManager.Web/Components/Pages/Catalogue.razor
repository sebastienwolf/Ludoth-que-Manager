@page "/catalogue"
@using LudothequeManager.Models
@using LudothequeManager.Data
@rendermode InteractiveServer

<PageTitle>Catalogue</PageTitle>

<h1>Catalogue des jeux</h1>
<a class="btn btn-primary" href="/jeux/ajouter">
    Ajouter un jeu
</a>

<input type="search" class="form-control" placeholder="Rechercher un jeu" aria-label="Rechercher un jeu"
       @bind="searchText" @bind:event="oninput" />


<p>@FilteredGames.Count() résultat(s) sur @games.Count() jeux </p>

<label>
        <input type="checkbox" @bind="showAvailableOnly" />
        Afficher uniquement les jeux disponibles
    </label>
    
<table class="table">
    <thead>
        <tr>
            <th>Numéro</th>
            <th>Nom</th>
            <th>Éditeur</th>
            <th>Statut</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var game in FilteredGames)
        {
            <tr>
                <td>@game.Id</td>
                <td>@game.Name</td>
                <td>@game.Publisher</td>
                <td>
                    <span class="badge @GetStatusClass(game.Status)">
                        @GetStatusLabel(game.Status)
                    </span>
                </td>
                <td>
                    <button class="btn btn-primary" @onclick="() => selectedGame = game">
                        Détails
                    </button>
                    <a class="btn btn-secondary" href="@($"/jeux/modifier/{game.Id}")">Modifier</a>
                    <a class="btn btn-outline-danger" href="@($"/jeux/supprimer/{game.Id}")">Supprimer</a>
                </td>
            </tr>
        }
    </tbody>
</table>
@if (selectedGame != null)
{
    <h2>@selectedGame.Name</h2>
    <p>Éditeur : @selectedGame.Publisher</p>
    <p>
        Statut :
        <span class="badge @GetStatusClass(selectedGame.Status)">
            @GetStatusLabel(selectedGame.Status)
        </span>
    </p>

    <button class="btn btn-secondary" @onclick="() => selectedGame = null">
        Fermer
    </button>
}
@if (!FilteredGames.Any())
{
    <p>Aucun jeu ne correspond à votre recherche.</p>
}

@code {

    private List<Game> games = new();
    private bool showAvailableOnly = false;
    private string searchText = "";
    private Game? selectedGame;
    protected override void OnInitialized()
    {
        using LudothequeDbContext? db = new LudothequeDbContext();
        games = db.Games.ToList();

        
    }
    private string GetStatusLabel(GameStatus status)
    {
        return status switch
        {
            GameStatus.Available => "Disponible",
            GameStatus.CheckedOut => "Emprunté",
            GameStatus.Maintenance => "En maintenance",
            _ => "Statut inconnu"
        };
    }

    private IEnumerable<Game> FilteredGames => games.Where(game =>
    (!showAvailableOnly || game.Status == GameStatus.Available)
    && game.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase));
    
    private string GetStatusClass(GameStatus status)
    {
        return status switch
        {
            GameStatus.Available => "bg-success",
            GameStatus.CheckedOut => "bg-warning text-dark",
            GameStatus.Maintenance => "bg-danger",
            _ => "bg-secondary"
        };
    }
}
